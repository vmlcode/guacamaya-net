{
  "name": "guacamaya-net",
  "private": true,
  "workspaces": [
    "packages/*",
    "guacamalla-api",
    "web/*"
  ],
  "scripts": {
    "dev:api": "bun run --cwd guacamalla-api dev",
    "dev:landing": "bun run --cwd web/landing dev",
    "build": "bun run --cwd packages/shared build && bun run --cwd guacamalla-api build && bun run --cwd web/landing build",
    "test": "bun test",
    "keygen": "bun run guacamalla-api/src/security/keygen.ts"
  },
  "engines": {
    "bun": ">=1.1"
  }
}
